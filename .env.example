# ORBITAL — toutes les valeurs restent vides dans cet exemple.
# Copier ce fichier vers .env.local, puis ne renseigner que les services utilisés.

# ACLED — facultatif. Sans identifiants, le connecteur reste indisponible.
# ACLED_ACCESS_TOKEN : jeton OAuth déjà obtenu ; alternative au couple email/mot de passe.
# Valeur par défaut réelle : aucune. Obtenir l'accès : https://acleddata.com/register/
ACLED_ACCESS_TOKEN=
# ACLED_EMAIL : adresse du compte ACLED, obligatoire avec ACLED_PASSWORD si aucun jeton direct.
# Valeur par défaut réelle : aucune.
ACLED_EMAIL=
# ACLED_PASSWORD : mot de passe du compte ACLED, obligatoire avec ACLED_EMAIL si aucun jeton direct.
# Valeur par défaut réelle : aucune. Ne jamais le versionner.
ACLED_PASSWORD=
# ACLED_DISABLED : facultatif ; mettre 1 pour désactiver ACLED. Défaut : activé si des identifiants existent.
# Aucune clé à obtenir pour ce réglage.
ACLED_DISABLED=

# UCDP — facultatif. Sans jeton, ORBITAL utilise les fichiers GED Candidate publics mensuels.
# UCDP_ACCESS_TOKEN : jeton de l'API UCDP, obtenu via https://ucdp.uu.se/downloads/apidocumentation/.
# Valeur par défaut réelle : aucune (repli public GED Candidate).
UCDP_ACCESS_TOKEN=
# UCDP_VERSION : version de l'API GED. Défaut réel : 26.1.
# Aucune clé à obtenir ; consulter la documentation UCDP pour les versions disponibles.
UCDP_VERSION=
# UCDP_DISABLED : facultatif ; mettre 1 pour désactiver UCDP. Défaut : 0 (connecteur actif).
# Aucune clé à obtenir pour ce réglage.
UCDP_DISABLED=

# NASA FIRMS — facultatif ; sans MAP_KEY, les anomalies thermiques sont désactivées.
# FIRMS_MAP_KEY : clé gratuite envoyée par NASA FIRMS : https://firms.modaps.eosdis.nasa.gov/api/map_key/.
# Valeur par défaut réelle : aucune.
FIRMS_MAP_KEY=
# FIRMS_DISABLED : facultatif ; mettre 1 pour désactiver FIRMS. Défaut : activé si FIRMS_MAP_KEY existe.
# Aucune clé à obtenir pour ce réglage.
FIRMS_DISABLED=

# GDELT Events — aucune clé requise.
# GDELT_DISABLED : facultatif ; mettre 1 pour désactiver GDELT. Défaut : 0 (actif).
GDELT_DISABLED=
# GDELT_EVENTS_CATCHUP_FILES : nombre de fichiers de 15 min à rattraper, borné entre 1 et 672. Défaut : 96 (24 h).
GDELT_EVENTS_CATCHUP_FILES=
# GDELT_EVENTS_BUDGET_MS : budget d'un passage, borné entre 5 000 et 600 000 ms. Défaut : 100 000 ms.
GDELT_EVENTS_BUDGET_MS=

# Persistance et ingestion — aucune clé fournisseur requise.
# DATABASE_URL : facultatif ; URL PostgreSQL prioritaire sur le stockage local. Défaut : aucune.
# L'URL est fournie par votre hébergeur ou administrateur PostgreSQL.
DATABASE_URL=
# ORBITAL_STORAGE : facultatif ; mettre json pour forcer l'ancien stockage JSON. Défaut : SQLite local.
ORBITAL_STORAGE=
# ORBITAL_SQLITE_PATH : facultatif ; chemin de la base SQLite. Défaut réel : data/intel-events.sqlite.
ORBITAL_SQLITE_PATH=
# ORBITAL_SQLITE_BUSY_TIMEOUT_MS : facultatif ; attente d'un verrou SQLite en ms. Défaut : 5 000.
ORBITAL_SQLITE_BUSY_TIMEOUT_MS=
# ORBITAL_RETENTION_GDELT_DAYS : facultatif ; rétention GDELT en jours (entier positif ou nul). Défaut : 30.
ORBITAL_RETENTION_GDELT_DAYS=
# ORBITAL_RETENTION_FIRMS_DAYS : facultatif ; rétention FIRMS en jours (entier positif ou nul). Défaut : 14.
ORBITAL_RETENTION_FIRMS_DAYS=
# INTEL_STORE_PATH : facultatif ; chemin JSON si ORBITAL_STORAGE=json. Défaut réel : data/intel-events.json.
INTEL_STORE_PATH=
# INGEST_TOKEN : secret obligatoire uniquement pour activer POST /api/ingest ; sans valeur, la route renvoie 503.
# Le générer localement avec un générateur cryptographique, par exemple `openssl rand -hex 32`.
INGEST_TOKEN=

# AURA — facultatif. Sans clé OpenAI, l'analyse IA reste indisponible.
# OPENAI_API_KEY : clé serveur créée sur https://platform.openai.com/api-keys ; jamais NEXT_PUBLIC_*.
OPENAI_API_KEY=
# OPENAI_MODEL : modèle Responses API. Défaut réel : gpt-5.6-terra.
# Aucun secret supplémentaire ; le modèle doit être accessible au projet OpenAI associé à la clé.
OPENAI_MODEL=

# Protection de la route AURA — réglages facultatifs, aucune clé à obtenir.
# AURA_ALLOWED_ORIGINS : origines supplémentaires séparées par des virgules. Défaut : aucune (même origine seulement).
AURA_ALLOWED_ORIGINS=
# AURA_TRUST_PROXY : mettre 1 uniquement derrière un proxy de confiance. Défaut : 0.
AURA_TRUST_PROXY=
# AURA_MAX_OUTPUT_TOKENS : sortie par réponse, entre 600 et 6 000. Défaut : 3 000.
AURA_MAX_OUTPUT_TOKENS=
# AURA_DEADLINE_MS : délai total, entre 1 000 et 300 000 ms. Défaut : 90 000 ms.
AURA_DEADLINE_MS=
# AURA_IDLE_MS : délai maximal sans donnée du flux, entre 500 et 120 000 ms. Défaut : 40 000 ms.
AURA_IDLE_MS=
# AURA_MAX_CONCURRENT : requêtes AURA simultanées globales, entre 1 et 10. Défaut : 2.
AURA_MAX_CONCURRENT=
# AURA_CLIENT_PER_MINUTE : requêtes par client et par minute, entre 1 et 60. Défaut : 6.
AURA_CLIENT_PER_MINUTE=
# AURA_GLOBAL_PER_MINUTE : requêtes globales par minute, entre 1 et 300. Défaut : 20.
AURA_GLOBAL_PER_MINUTE=
# AURA_DAILY_LIMIT : requêtes globales par jour, entre 1 et 5 000. Défaut : 300.
AURA_DAILY_LIMIT=

# Voix d'AURA — synthèse neurale facultative, servie par /api/agent/voice avec la clé OpenAI.
# Sans clé ou si le service échoue, la voix du navigateur prend le relais : aucune réponse n'est bloquée.
# AURA_TTS_MODEL : modèle de synthèse vocale. Défaut réel : gpt-4o-mini-tts.
AURA_TTS_MODEL=
# AURA_TTS_VOICE : timbre par défaut (nova, shimmer, coral, sage, alloy, ballad, ash, marin, echo, verse, onyx, cedar). Défaut réel : nova.
AURA_TTS_VOICE=
# AURA_TTS_MAX_CHARS : longueur d'un segment vocal envoyé à la synthèse, entre 80 et 4 000. Défaut : 1 200.
AURA_TTS_MAX_CHARS=
# AURA_TTS_MAX_CHARS_PER_DAY : budget vocal quotidien en caractères, entre 1 000 et 500 000. Défaut : 60 000.
AURA_TTS_MAX_CHARS_PER_DAY=
# AURA_TTS_REQUESTS_PER_MINUTE : segments vocaux par minute et par client, entre 1 et 240. Défaut : 30.
AURA_TTS_REQUESTS_PER_MINUTE=
# AURA_TTS_DISABLED : mettre 1 pour couper la voix payante et ne garder que la voix du navigateur. Défaut : 0 (actif si OPENAI_API_KEY existe).
AURA_TTS_DISABLED=
