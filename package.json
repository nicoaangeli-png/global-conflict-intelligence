{
  "name": "orbital-conflict-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-cesium-assets.cjs",
    "prebuild": "node scripts/prepare-cesium-assets.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-migrations.test.ts tests/intel-migration-postgres.test.ts tests/detection-postgres.test.ts tests/detection-store-contract.test.ts tests/detection-migration-script.test.ts tests/detection-sqlite-migrations.test.ts tests/detection-backend.test.ts tests/detection-clustering-backends.test.ts tests/detection-revisions.test.ts tests/detection-postgres-deadlock.test.ts tests/detection-benchmark.test.ts tests/aura-rate-limit-postgres.test.ts tests/public-api-postgres.test.ts",
    "benchmark:detection": "ORBITAL_BENCHMARK_FULL=1 vitest run tests/detection-benchmark.test.ts --reporter=verbose --silent=false",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test tests/mobile",
    "typecheck": "tsc --noEmit --incremental false",
    "migrate:detection": "node scripts/migrate-detection-sqlite-to-postgres.cjs",
    "audit:deps": "pnpm audit"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  }
}
